# AI Job Agent — environment template.
# Copy this file to .env in the repository root and fill in the values (or
# export them in your shell). .env is gitignored; never commit real keys.

# --- Model providers -------------------------------------------------------
# The default cascade and the document generator run on Anthropic models, so
# ANTHROPIC_API_KEY is the one key you need. GOOGLE_API_KEY (Gemini) and
# OPENAI_API_KEY are used by the fallback chains and by model overrides.
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# --- Optional research and scraping providers ------------------------------
# Perplexity: company profile, careers-page lookup, borderline-job enrichment.
PERPLEXITY_API_KEY=
# SerpAPI: the Google Jobs source.
SERPAPI_KEY=
# Hunter: verifies contact emails in the post-apply outreach playbook.
HUNTER_API_KEY=
# Reddit job subreddits (a "script" app from reddit.com/prefs/apps).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# --- Candidate profile ------------------------------------------------------
# Path to your profile YAML. Unset, the agent reads profiles/profile.yaml and
# falls back to the fictional profiles/example.yaml. See docs/CONFIGURING.md.
JOB_AGENT_PROFILE=

# Header of generated CVs and cover letters, and the document file names.
CANDIDATE_NAME=
CANDIDATE_EMAIL=
CANDIDATE_PHONE=
CANDIDATE_LOCATION=

# --- Email digest -----------------------------------------------------------
# SMTP login of the sending account and a comma-separated recipient list.
EMAIL_SENDER=
EMAIL_PASSWORD=
EMAIL_RECIPIENTS=
# Where pipeline error alerts go (leave empty to skip alerts).
ERROR_ALERT_EMAIL=

# --- Web API ----------------------------------------------------------------
# Browser origins allowed to call the FastAPI backend, comma-separated.
# Default: http://localhost:8503 (the Next.js frontend on the same machine).
# Add an origin here when you open the frontend under another host name,
# e.g. CORS_ALLOWED_ORIGINS=http://localhost:8503,http://my-server:8503
CORS_ALLOWED_ORIGINS=http://localhost:8503

# --- Documents --------------------------------------------------------------
# CV content mode: B0 (default) ships the routed base CV's own bullets;
# B2 selects bullets per job from the pool built by scripts/build_cv_pool.py.
CV_CONTENT_MODE=B0

# --- LangFuse cascade observability (self-hosted; see ops/langfuse/) --------
# These three may also live in ops/langfuse/langfuse-keys.conf (gitignored,
# loaded by config.py). Values set in the environment take precedence.
# Set JOB_AGENT_DISABLE_LANGFUSE=1 to switch tracing off for one process.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
